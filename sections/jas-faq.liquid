{% comment %}Jamal Shopify Sections • MIT • No JavaScript required.{% endcomment %}
<div id="jas-faq-{{ section.id }}" class="jas-faq">
  {% if section.settings.heading != blank %}
    <h2>{{ section.settings.heading | escape }}</h2>
  {% endif %}
  {% for block in section.blocks %}
    {% if block.settings.question != blank %}
      <details {{ block.shopify_attributes }} {% if section.settings.open_first and forloop.first %}open{% endif %}>
        <summary>{{ block.settings.question | escape }}</summary>
        <div class="jas-faq__answer">{{ block.settings.answer }}</div>
      </details>
    {% endif %}
  {% endfor %}
</div>
{% style %}
  #jas-faq-{{ section.id }} {
    max-width: 860px; margin: 0 auto; padding: 48px 20px;
    color: {{ section.settings.text_color }}; background: {{ section.settings.background }};
    font-family: inherit; line-height: 1.6; overflow-wrap: anywhere;
  }
  #jas-faq-{{ section.id }} h2 { color: inherit; font-size: clamp(26px, 4vw, 40px); margin: 0 0 24px; }
  #jas-faq-{{ section.id }} details { border-bottom: 1px solid currentColor; }
  #jas-faq-{{ section.id }} summary { cursor: pointer; padding: 20px 8px; font-size: 18px; font-weight: 600; }
  #jas-faq-{{ section.id }} summary:focus-visible { outline: 3px solid currentColor; outline-offset: 3px; }
  #jas-faq-{{ section.id }} .jas-faq__answer { padding: 0 8px 20px; }
  #jas-faq-{{ section.id }} .jas-faq__answer p { margin: 0 0 12px; }
  #jas-faq-{{ section.id }} a { color: inherit; text-decoration: underline; }
{% endstyle %}
{% schema %}
{
  "name": "JAS FAQ",
  "tag": "section",
  "max_blocks": 20,
  "settings": [
    {"type":"text","id":"heading","label":"Heading","default":"Frequently asked questions"},
    {"type":"checkbox","id":"open_first","label":"Open first answer","default":false},
    {"type":"color","id":"text_color","label":"Text color","default":"#183D35"},
    {"type":"color","id":"background","label":"Background","default":"#FAF8F3"}
  ],
  "blocks": [
    {"type":"question","name":"Question","settings":[
      {"type":"text","id":"question","label":"Question","default":"How can I contact you?"},
      {"type":"richtext","id":"answer","label":"Answer","default":"<p>Add your store's contact details here.</p>"}
    ]}
  ],
  "presets":[{"name":"JAS FAQ","blocks":[{"type":"question"},{"type":"question"},{"type":"question"}]}]
}
{% endschema %}
